{{ 'section-demo-icons.css' | asset_url | stylesheet_tag }}
{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="{{ 'section-demo-icons.js' | asset_url }}" defer></script>

<div class="swiper-block">
  {%- for block in section.blocks -%}
    {% assign products = block.settings.collection.products %}
    {{ products | json }}
    {%- if block.type == 'slide' -%}
      <div class="swiper-container">
        <div class="swiper-wrapper">
          {%- for product in products -%}
            <div class="swiper-slide" id="{{ product.id }}">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url }}" alt="" width="100" height="100" loading="lazy">
              {% endif %}
              <div class="swiper-slide-footer">
                <h3>{{ product.title | escape }}</h3>
                <div class="price">{{ product.price | money_with_currency }}</div>
                <button class="btn">
                  Add To Cart
                  {% render 'icon-buy' %}
                </button>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="swiper-button-prev">{% render 'arrow-left' %}</div>
        <div class="swiper-button-next">{% render 'arrow-right' %}</div>
        <div class="swiper-pagination"></div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "选择产品集"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Demo Icons",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
