{{ 'video-list.css' | asset_url | stylesheet_tag }}
{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}
{{ 'https://cdn.plyr.io/3.8.4/plyr.css' | stylesheet_tag }}
<script src="https://cdn.plyr.io/3.8.4/plyr.polyfilled.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="{{ 'video-list.js' | asset_url }}" defer></script>
{%- style -%}
  #Banner-{{ section.id }} {
    background-color: #000000;
  }
{%- endstyle -%}

<div
  id="Banner-{{ section.id }}"
  class="video-list-section{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="video-list-container">
    <div class="swiper video-list-swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video-item' and block.settings.video_url != blank -%}
            {%- assign video_url = block.settings.video_url -%}
            {%- assign poster = block.settings.poster -%}
            <div class="swiper-slide video-list-slide" {{ block.shopify_attributes }}>
              <div
                class="video-list-thumbnail"
                data-videosrc="{{ video_url | escape }}"
                data-poster-src="{{ poster | image_url: width: 800 }}"
              >
                {%- if poster != blank -%}
                  {{
                    poster
                    | image_url: width: 800
                    | image_tag:
                      widths: '375, 550, 750, 1100',
                      sizes: '(min-width: 750px) 25vw, 50vw',
                      alt: block.settings.title,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg video-list-placeholder' }}
                {%- endif -%}
                <span class="video-list-play">
                  {{- 'icon-play.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="video-list-mask"></div>
    </div>
  </div>
  <div class="video-list-modal">
    <div class="video-list-modal-content">
      <div class="video-list-modal-close">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </div>
      <video
        id="VideoListPlayer"
        class="video-list-player plyr"
        playsinline
        controls
        data-poster="{{ section.blocks.first.settings.video.preview_image | image_url: width: 800 }}"
      >
        <source src="{{ section.blocks.first.settings.video.url }}" type="video/mp4">
      </video>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "video-block",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "video-item",
      "name": "video",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Paste an MP4, YouTube, or Vimeo link"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "video-block",
      "blocks": [
        {
          "type": "video-item"
        }
      ]
    }
  ]
}
{% endschema %}
