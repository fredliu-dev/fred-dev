{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drop' %}
{% endcomment %}

<header-drop
  class="header-drop"
  data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}"
  style="grid-area:icons;"
>
  <details id="Details-menu-drop-container" class="menu-drop-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drop" class="gradient menu-drop motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drop__inner-container">
        <div class="menu-drop__navigation-container">
          <nav class="menu-drop__navigation">
            <ul class="menu-drop__menu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li class="menu-drop__item">
                  {%- if link.links != blank -%}
                    <div class="menu-drop__dropdown" data-menu-drop-dropdown>
                      <button
                        id="HeaderDrop-{{ link.handle }}"
                        class="menu-drop__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drop__menu-item--active{% endif %}"
                        aria-expanded="false"
                        aria-controls="HeaderDrop-submenu-{{ link.handle }}"
                      >
                        {{ link.title | escape }}
                        <span class="svg-wrapper menu-drop__arrow">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </button>
                      <div
                        id="HeaderDrop-submenu-{{ link.handle }}"
                        class="menu-drop__submenu gradient motion-reduce"
                        hidden
                      >
                        {%- assign first_child = link.links | first -%}
                        {%- assign has_images = false -%}
                        {%- if first_child.object.image.src != blank -%}
                          {%- assign has_images = true -%}
                        {%- endif -%}
                        <ul
                          class="menu-drop__menu menu-drop__menu--sub list-menu{% if has_images %} menu-drop__menu--grid{% endif %}"
                          role="list"
                        >
                          {%- for childlink in link.links -%}
                            <li class="menu-drop__item{% if has_images %} menu-drop__item--grid{% endif %}">
                              {%- if has_images -%}
                                <a
                                  id="HeaderDrop-{{ link.handle }}-{{ childlink.handle }}"
                                  href="{{ childlink.url }}"
                                  class="menu-drop__menu-item menu-drop__menu-item--grid link link--text focus-inset{% if childlink.current %} menu-drop__menu-item--active{% endif %}"
                                  {% if childlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  <img
                                    src="{{ childlink.object.image.src | img_url: 'medium' }}"
                                    alt="{{ childlink.title | escape }}"
                                    class="menu-drop__grid-image lazyload"
                                    loading="lazy"
                                    height="56"
                                    width="56"
                                  >
                                  <span class="menu-drop__grid-title">{{ childlink.title | escape }}</span>
                                </a>
                              {%- else -%}
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrop-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drop__menu-item menu-drop__menu-item--child link link--text list-menu__item focus-inset{% if childlink.current %} menu-drop__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <div class="menu-drop__dropdown menu-drop__dropdown--nested" data-menu-drop-dropdown>
                                    <button
                                      id="HeaderDrop-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drop__menu-item menu-drop__menu-item--child link link--text list-menu__item focus-inset"
                                      aria-expanded="false"
                                      aria-controls="HeaderDrop-submenu-{{ link.handle }}-{{ childlink.handle }}"
                                    >
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper menu-drop__arrow">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </button>
                                    <div
                                      id="HeaderDrop-submenu-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drop__submenu menu-drop__submenu--nested gradient motion-reduce"
                                      hidden
                                    >
                                      <ul class="menu-drop__menu menu-drop__menu--sub list-menu" role="list">
                                        {%- for grandchildlink in childlink.links -%}
                                          <li class="menu-drop__item">
                                            <a
                                              id="HeaderDrop-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drop__menu-item menu-drop__menu-item--grandchild link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drop__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </div>
                                {%- endif -%}
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </div>
                  {%- else -%}
                    <a
                      id="HeaderDrop-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drop__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drop__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          <div class="menu-drop__utility-links">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="menu-drop__account link focus-inset h5 medium-hide large-up-hide"
                rel="nofollow"
              >
                {%- if section.settings.enable_customer_avatar -%}
                  <account-icon>
                    {%- if customer and customer.has_avatar? -%}
                      {{ customer | avatar }}
                    {%- else -%}
                      <span class="svg-wrapper">
                        {{- 'icon-account.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </account-icon>
                {%- else -%}
                  <span class="svg-wrapper">
                    {{- 'icon-account.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
            {%- if localization.available_countries or localization.available_languages -%}
              <div class="menu-drop__localization header-localization">
                {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-twitter.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-facebook.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-pinterest.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-instagram.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tiktok.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tumblr.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-snapchat.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-youtube.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-vimeo.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drop>

<style>
  .menu-drop-container {
    display: flex;
  }
  .menu-drop {
    position: absolute;
    transform: translateX(-100%);
    visibility: hidden;
    z-index: 3;
    left: 0;
    top: 100%;
    width: 100%;
    padding: 0;
    background-color: rgb(var(--color-background));
    overflow-x: hidden;
    filter: drop-shadow(
      var(--drawer-shadow-horizontal-offset) var(--drawer-shadow-vertical-offset) var(--drawer-shadow-blur-radius)
        rgba(var(--color-shadow), var(--drawer-shadow-opacity))
    );
  }

  .js .menu-drop {
    height: calc(100vh - 100%);
    height: calc(var(--viewport-height, 100vh) - (var(--header-bottom-position, 100%)));
  }

  .js details[open] > .menu-drop {
    transition: transform var(--duration-default) ease, visibility var(--duration-default) ease;
  }

  .js details[open].menu-opening > .menu-drop {
    transform: translateX(0);
    visibility: visible;
  }

  .menu-drop__inner-container {
    position: relative;
    height: 100%;
  }

  .menu-drop__navigation-container {
    display: grid;
    grid-template-rows: 1fr auto;
    align-content: space-between;
    overflow-y: auto;
    height: 100%;
  }

  .menu-drop__navigation {
  }

  .menu-drop__menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .menu-drop__item {
    margin: 0;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }

  .menu-drop__dropdown {
    width: 100%;
  }

  .menu-drop__menu-item {
    padding: 1.1rem 3rem;
    text-decoration: none;
    font-size: 1.8rem;
    width: 100%;
    text-align: left;
    background-color: transparent;
    border: none;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    color: rgb(var(--color-foreground));
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-drop__menu-item--active,
  .menu-drop__menu-item:focus,
  .menu-drop__menu-item:hover {
    color: rgb(var(--color-foreground));
    background-color: rgba(var(--color-foreground), 0.04);
  }

  .menu-drop__menu-item > .svg-wrapper {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform var(--duration-default) ease;
  }

  .menu-drop__menu-item[aria-expanded='true'] > .svg-wrapper {
    transform: rotate(180deg);
  }

  .menu-drop__submenu {
    width: 100%;
    background-color: rgba(var(--color-foreground), 0.03);
    border-left: 0.2rem solid rgba(var(--color-foreground), 0.1);
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--duration-default) ease;
  }

  .menu-drop__submenu[hidden] {
    display: block;
    max-height: 0;
  }

  .menu-drop__submenu.is-open {
    max-height: 100vh;
  }

  .menu-drop__submenu--nested {
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .menu-drop__menu-item--child {
    padding-left: 4rem;
  }

  .menu-drop__menu-item--grandchild {
    padding-left: 5rem;
  }

  .menu-drop__submenu .menu-drop__menu-item {
    font-size: 1.6rem;
  }

  .menu-drop__submenu--nested .menu-drop__menu-item {
    font-size: 1.5rem;
  }

  /* 图片网格布局 */
  .menu-drop__menu--grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 1rem 30px;
  }

  .menu-drop__item--grid {
    border-bottom: none;
  }
  .menu-drop__item--grid img {
    margin-top: 8px;
  }
  .menu-drop__menu-item--grid {
    flex-direction: column;
    padding: 0;
    text-align: center;
    background: none;
    border: none;
    justify-content: flex-start;
    padding: 16px 0;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }
  .menu-drop__item--grid:nth-last-child(-n + 4) .menu-drop__menu-item--grid {
    border: none;
  }

  .menu-drop__menu-item--grid .menu-drop__grid-image {
    width: 56px;
    height: 56px;
    object-fit: contain;
    margin: 0;
    margin-bottom: 0.5rem;
  }

  .menu-drop__menu-item--grid .menu-drop__grid-title {
    color: var(--Dark_Text_Grey, #7e7e7e);
    text-align: center;
    font-family: 'Replica Pro';
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: capitalize;
  }

  .menu-drop__utility-links {
    padding: 0;
    background-color: rgba(var(--color-foreground), 0.03);
    position: relative;
  }

  .menu-drop__account {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    padding: 1rem 0;
    font-size: 1.4rem;
    color: rgb(var(--color-foreground));
    margin-bottom: 0;
  }

  .menu-drop__account account-icon > .svg-wrapper {
    height: 2rem;
    width: 2rem;
    margin-right: 1rem;
  }

  .menu-drop__account shop-user-avatar {
    --shop-avatar-size: 2.4rem;
    margin-right: 0.55rem;
    margin-left: -0.45rem;
  }

  .menu-drop .list-social {
    justify-content: flex-start;
    margin-left: -1.25rem;
  }

  .menu-drop .list-social:empty {
    display: none;
  }

  .menu-drop .list-social__link {
    padding: 1.1rem 1.1rem;
  }

  @media screen and (min-width: 750px) {
    .header-drop {
      display: none;
    }
    .menu-drop {
      width: 40rem;
      border-width: 0 var(--drawer-border-width) 0 0;
      border-style: solid;
      border-color: rgba(var(--color-foreground), var(--drawer-border-opacity));
    }
  }

  @media screen and (max-width: 749px) {
    .header-drop {
      display: block;
    }
    .menu-drop.country-selector-open {
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  (function () {
    const drawer = document.querySelector('header-drop');
    if (!drawer) return;

    const details = drawer.querySelector('details');
    const summary = drawer.querySelector('summary');

    // 处理抽屉展开/收起，实现与 menu-drawer 相同的动画行为
    function openDrawer() {
      details.setAttribute('open', '');
      requestAnimationFrame(() => {
        details.classList.add('menu-opening');
      });
      summary.setAttribute('aria-expanded', 'true');
      document.body.classList.add(`overflow-hidden-${drawer.dataset.breakpoint}`);
    }

    function closeDrawer() {
      details.classList.remove('menu-opening');
      document.body.classList.remove(`overflow-hidden-${drawer.dataset.breakpoint}`);
      setTimeout(() => {
        details.removeAttribute('open');
      }, 300);
      summary.setAttribute('aria-expanded', 'false');
    }

    summary.addEventListener('click', (event) => {
      event.preventDefault();
      if (details.hasAttribute('open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    // PC 端时自动关闭抽屉
    window.addEventListener('resize', () => {
      if (details.hasAttribute('open') && window.matchMedia('(min-width: 990px)').matches) {
        closeDrawer();
      }
    });

    // 点击遮罩/外部关闭抽屉
    summary.addEventListener('click', (event) => {
      if (event.target === summary && details.hasAttribute('open')) {
        closeDrawer();
      }
    });

    drawer.querySelectorAll('[data-menu-drop-dropdown]').forEach((dropdown) => {
      const button = dropdown.querySelector('.menu-drop__menu-item');
      const submenu = dropdown.querySelector('.menu-drop__submenu');
      if (!button || !submenu) return;

      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const isOpen = submenu.classList.contains('is-open');

        if (isOpen) {
          submenu.classList.remove('is-open');
          submenu.addEventListener(
            'transitionend',
            () => {
              submenu.setAttribute('hidden', '');
            },
            { once: true }
          );
          button.setAttribute('aria-expanded', 'false');
        } else {
          submenu.removeAttribute('hidden');
          requestAnimationFrame(() => {
            submenu.classList.add('is-open');
          });
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });

    if (details) {
      details.addEventListener('toggle', () => {
        if (!details.hasAttribute('open')) {
          drawer.querySelectorAll('[data-menu-drop-dropdown]').forEach((dropdown) => {
            const button = dropdown.querySelector('.menu-drop__menu-item');
            const submenu = dropdown.querySelector('.menu-drop__submenu');
            if (!button || !submenu) return;
            submenu.classList.remove('is-open');
            submenu.setAttribute('hidden', '');
            button.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
  })();
</script>
